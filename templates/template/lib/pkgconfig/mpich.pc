# this gives access to the mpich header files
prefix=__MPICH_DIR__
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
therock_includedir=__MPICH_DEST_DIR__/include

Name: mpich
Description: High Performance and portable MPI
Version: 3.4a2
URL: http://www.mcs.anl.gov/research/projects/mpich
Requires:
Libs: -Wl,-rpath -Wl,${exec_prefix}/lib -Wl,--enable-new-dtags   -L${libdir} -lmpi  -lm  -ludev -lpciaccess  -lxml2   -lpthread  -lfabric -L/opt/cray/libfabric/1.22.0/lib64 -lfabric -lcxi -lm -latomic -lpthread -ldl  
Cflags:  -I${therock_includedir}  -I${includedir}

# pkg-config does not understand Cxxflags, etc. So we allow users to
# query them using the --variable option

cxxflags= -I${therock_includedir} -I${includedir}
fflags= -I${therock_includedir} -I${includedir}
fcflags= -I${therock_includedir} -I${includedir}
